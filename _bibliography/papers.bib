@article{mehta2026iwsp,
  title={Interpretable Weight-Space Programming Builds Transparent Transformers and Brain Encoding Models},
  author={Mehta, Yash and Singh, Chandan and Xu, Weijia and Antonello, Richard J. and Flinker, Adeen and Mesgarani, Nima and Bonner, Michael F. and Jojic, Nebojsa and Gao, Jianfeng},
  journal={Preprint},
  year={2026},
  month={11},
  abbr={Preprint},
  pdf={https://www.alphaxiv.org/abs/2611.interpretable-weight-space-programming},
  code={https://github.com/csinva/weight-space-programming-autoresearch},
  preview={iwsp2026.jpg},
  teaser={iwsp2026.mp4},
  topic={discovery},
  place={msr},
  abstract={Neural networks are powerful predictors, yet their opacity limits their usefulness in science, where the goal is explanation rather than mere prediction. In neuroscience, for example, deep encoding models accurately predict brain activity in response to natural stimuli, but struggle to reveal which stimulus features drive those predictions. Here we introduce interpretable weight-space programming (iWSP), a method in which an LLM agent iteratively builds interpretable models by explicitly programming their weights and features in code, without gradient-based training (backpropagation). Without backpropagation to tune parameters, the agent must draw on its prior knowledge and reason over previous trials to hypothesize, "hand-craft", and refine human-interpretable computations mirroring the workflow of a human scientist. LLM audits confirm the interpretability of the hand-crafted models. We first validate iWSP by tasking it with constructing transformers for canonical benchmarks such as arithmetic and sentiment classification, finding that LLM agents can successfully craft compact, accurate networks directly. Next, we apply iWSP to build neural encoding models across vision, language, and audition. In the visual cortex, iWSP outpredicts existing interpretable baselines, uncovers distinct computations across early/higher visual areas, and generalizes to unseen data. In language fMRI, iWSP surfaces a confound in the data and in auditory ECoG, it systematically discovers interpretable acoustic features that predict neural activity. Together, these results establish iWSP as a general paradigm for aligning high predictive performance with human-interpretable scientific discovery.},
  figure={kernel},
  selected={true}
}

@article{mehta2026coarse,
  title={Extremely Coarse Learning Objectives Induce Human-Aligned Representations in AI Vision Models},
  author={Mehta, Yash and Bonner, Michael F.},
  journal={arXiv preprint},
  year={2026},
  month={5},
  abbr={arXiv},
  arxiv={2605.05556},
  code={https://github.com/yashsmehta/visreps},
  preview={coarse2026.png},
  teaser={coarse2026.mp4},
  topic={neuro-ai},
  place={jhu},
  abstract={Artificial neural networks trained on visual tasks develop internal representations resembling those of the primate visual system, a discovery that has guided a decade of computational neuroscience. Research on building brain-aligned models has progressively embraced finer-grained learning objectives, from object classification to contrastive self-supervised objectives that maximize distinctions among individual images. Yet the effect of learning-signal granularity on brain alignment remains largely unexamined. Here we systematically investigate how the granularity of a learning signal shapes representational alignment with human vision. We parametrically vary the number of training classes using a data-driven approach that partitions a set of training images into different numbers of categories via PCA-based splits of pretrained embeddings. We train hundreds of neural networks across convolutional and transformer architectures on these coarse classification tasks and compare their representations with human fMRI responses, macaque electrophysiology recordings, and human behavior. We find that networks trained to distinguish as few as eight broad categories learn representations that match or exceed the neural alignment of models distinguishing 1,000 classes. Even more strikingly, these coarsely trained networks align more closely with human perceptual similarity judgments than all other models evaluated, including networks trained with fine-grained supervision or self-supervision as well as leading large-scale vision models. These results demonstrate that human-like visual representations can emerge from surprisingly simple learning objectives, reframing what learning signals vision may require and opening a path toward building AI systems that are more aligned with human perception.},
  figure={cloud},
  selected={true}
}

@inproceedings{mehta2024model,
  title={Model-Based Inference of Synaptic Plasticity Rules},
  author={Mehta, Yash and Tyulmankov, Dan and Rajagopalan, Adithya and Fitzgerald, James and Funke, Jan},
  booktitle={Advances in Neural Information Processing Systems (NeurIPS)},
  year={2024},
  website={https://yashsmehta.com/plasticity-paper-website/},
  pdf={https://www.biorxiv.org/content/10.1101/2023.12.11.571103v2},
  abbr={NeurIPS},
  code={https://github.com/yashsmehta/MetaLearnPlasticity},
  preview={plasticity2024.png},
  teaser={plasticity2024.mp4},
  topic={discovery},
  place={janelia},
  abstract={Synaptic plasticity, the ability of synapses to change their strength, is a key mechanism underlying learning in biological neural networks. However, inferring plasticity rules from neural recordings is challenging due to the complexity of biological networks and the difficulty of measuring synaptic weights directly. Here, we introduce a model-based approach to infer plasticity rules from neural activity alone, without requiring direct measurement of synaptic weights.},
  figure={rule},
  selected={true}
}

